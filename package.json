{
  "name": "afyacore",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Offline-first clinical data capture for Madagascar health facilities",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SyedMohammedSameer/AfyaCore.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vendor-ocr.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "sync": "node server/sync-server.mjs",
    "admin": "node server/cli.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "puppeteer-core": "^25.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
